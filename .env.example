# ===========================
# AI Career Copilot — Environment Variables
# ===========================
# Copy this file:
#   Backend  →  backend/.env
#   Frontend →  frontend/.env.local

# ─── Backend (.env) ───────────────────────────

# REQUIRED — change this to a random string
SECRET_KEY=change-me-use-a-random-64-char-string

# Database (default: SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./career_copilot.db

# CORS
FRONTEND_URL=http://localhost:3000

# ─── AI API Keys (provide at least one) ──────
# Get your Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OR get an OpenAI key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here

# AI Model (auto-detected from provider)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# ─── Frontend (.env.local) ────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=AI Career Copilot
